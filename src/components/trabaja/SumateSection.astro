---
import { Image } from 'astro:assets';
import Reveal from 'astro-reveal/Reveal.astro';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import IconHex from '../ui/IconHex.astro';
import BenefitItem from '../cards/BenefitItem.astro';
import { BENEFITS } from '../../data/trabaja';
import benefitsImage from '../../assets/images/trabaja-beneficios.png';

const paragraphs = [
  'Buscamos personas comprometidas, responsables y con ganas de crecer.',
  'Ofrecemos oportunidades, capacitación continua y la posibilidad de formar parte de grandes proyectos industriales.',
];
---

<Section id="trabaja">
  {/* 3 columns on desktop; below 1000px text + benefits side by side and the photo full width */}
  <div class="grid grid-cols-1 items-start gap-10 sm:grid-cols-2 lg:grid-cols-[1fr_1.15fr_0.85fr] lg:gap-12">
    <div>
      <Reveal>
        <SectionHeading as="h1" title="Sumate a SMI" />
      </Reveal>
      <div class="mt-6 grid gap-4">
        {paragraphs.map((text, i) => <Reveal as="p" index={i + 1}>{text}</Reveal>)}
      </div>
     
    </div>

    <Reveal index={1.5}>
      <div class="mb-5 flex items-center gap-3">
        <IconHex name="capacitacion" size={30} />
        <span class="type-eyebrow">Beneficios</span>
      </div>
      <ul class="grid gap-3">
        {BENEFITS.map((benefit) => <BenefitItem>{benefit}</BenefitItem>)}
      </ul>
    </Reveal>

    <Reveal index={2.5} distance="24px" class="sm:col-span-2 lg:col-span-1 lg:self-stretch">
      <Image
        src={benefitsImage}
        alt="Operario realizando hidrolavado en planta industrial"
        widths={[480, 720, 1024]}
        sizes="(min-width: 1000px) 300px, 100vw"
        class="block aspect-16/10 w-full rounded-lg object-cover shadow-media lg:aspect-auto lg:h-full"
      />
    </Reveal>
  </div>
</Section>
