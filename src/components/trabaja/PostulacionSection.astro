---
import Reveal from 'astro-reveal/Reveal.astro';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import IconHex from '../ui/IconHex.astro';
import Panel from '../ui/Panel.astro';
import ChannelLink from '../cards/ChannelLink.astro';
import PostulacionForm from './PostulacionForm.astro';
import { CHANNELS } from '../../data/site';

const rrhh = CHANNELS.find((c) => c.email.startsWith('recursoshumanos@'))!;
---

<Section id="postulacion" tone="alt">
  <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
    <div>
      <Reveal>
        <div class="mb-5 flex items-center gap-3">
          <IconHex name="postulacion" size={30} />
          <span class="type-eyebrow">Recursos humanos</span>
        </div>
        <SectionHeading title="Trabajá con nosotros" />
      </Reveal>
      <div class="mt-6 grid gap-4">
        <Reveal as="p" index={1} class="font-display font-bold text-heading">
          ¿Querés formar parte de SMI Servicios Industriales?
        </Reveal>
        <Reveal as="p" index={1.5}>
          Completá tus datos y adjuntá tu CV. Tu información será incorporada a nuestra base de candidatos para
          futuras oportunidades laborales.
        </Reveal>
      </div>
      <Reveal index={2} class="mt-8 grid gap-3">
        <ChannelLink {...rrhh} icon="recursos-humanos" />
      </Reveal>
    </div>

    <Reveal index={1.5}>
      <Panel>
        <PostulacionForm />
      </Panel>
    </Reveal>
  </div>
</Section>
