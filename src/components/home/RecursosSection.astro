---
import { Image } from 'astro:assets';
import Reveal from 'astro-reveal/Reveal.astro';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import IconHex from '../ui/IconHex.astro';
import warehouseImage from '../../assets/images/12-almacen-logistica.png';

const paragraphs = [
  'Realizamos la captación, evaluación y contratación de personal de acuerdo con los requisitos específicos de cada cliente.',
  'El operario trabaja bajo relación de dependencia con SMI dentro del espacio del cliente durante un período determinado, con posibilidad de incorporarse posteriormente a la planta permanente del cliente en caso de conformidad laboral.',
];
---

<Section id="rrhh">
  <div class="grid items-center gap-10 lg:grid-cols-[1fr_1.15fr] lg:gap-16">
    {/* Image first on desktop, after the text on mobile */}
    <Reveal distance="24px" class="max-lg:order-2">
      <Image
        src={warehouseImage}
        alt="Operación en almacén y logística"
        class="block w-full rounded-lg shadow-media"
      />
    </Reveal>

    <div>
      <Reveal>
        <div class="mb-5 flex items-center gap-3">
          <IconHex name="recursos-humanos" size={30} />
          <span class="type-eyebrow">Recursos humanos para empresas</span>
        </div>
        <SectionHeading title="Personal idóneo, evaluado y contratado por SMI" />
      </Reveal>
      <div class="mt-6 grid gap-4">
        {paragraphs.map((text, i) => <Reveal as="p" index={i + 1}>{text}</Reveal>)}
      </div>
      <Reveal index={3} class="mt-8">
        <Button href="/contacto">Solicitar presupuesto personalizado</Button>
      </Reveal>
    </div>
  </div>
</Section>
