---
import Reveal from 'astro-reveal/Reveal.astro';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import ServiceCard from '../cards/ServiceCard.astro';
import Button from '../ui/Button.astro';
import { HOME_SERVICES } from '../../data/home';

const FEATURED = 2;
---

<Section id="servicios" tone="alt">
  <Reveal>
    <SectionHeading
      align="center"
      title="Soluciones para entornos industriales"
      intro="Contamos con personal propio, equipos y procedimientos adecuados para brindar soluciones eficientes y seguras en todo tipo de entornos industriales. Nos adaptamos a los requerimientos específicos de cada cliente."
    />
  </Reveal>

  {/* 6-column grid: 2 featured cards span 3 columns each, the rest span 2 */}
  <div class="mt-12 grid gap-x-6 gap-y-10 sm:grid-cols-6">
    {
      HOME_SERVICES.map((service, i) => {
        const featured = i < FEATURED;
        return (
          <Reveal index={featured ? i : i - FEATURED} class={featured ? 'sm:col-span-3' : 'sm:col-span-2'}>
            <ServiceCard {...service} size={featured ? 'lg' : 'md'} href="/contacto" />
          </Reveal>
        );
      })
    }
  </div>

  <Reveal class="mt-12 flex justify-center">
    <Button variant="navy" href="/servicios">Ver más</Button>
  </Reveal>
</Section>
