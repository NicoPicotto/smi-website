---
import Icon from '../ui/Icon.astro';
import type { IconName } from '../../lib/icons';

/** Mail link by area: icon, uppercase area name, address. */
interface Props {
  title: string;
  email: string;
  icon?: IconName;
}

const { title, email, icon = 'email' } = Astro.props;
---

<a
  href={`mailto:${email}`}
  class="flex items-center gap-3 rounded-sm border border-line bg-surface px-4 py-3 text-body transition hover:border-accent hover:text-body"
>
  <Icon name={icon} size={18} class="text-navy-800" />
  <span class="grid min-w-0 text-sm">
    <span class="type-label text-xs text-heading">{title}</span>
    <span class="truncate">{email}</span>
  </span>
</a>
