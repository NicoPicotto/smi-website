---
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import type { IconName } from '../../lib/icons';

/** Navy call-to-action strip: icon, title + text, outline-light button. */
interface Props {
  title: string;
  action: string;
  href: string;
  icon?: IconName;
}

const { title, action, href, icon = 'presupuesto' } = Astro.props;
---

<div
  class="flex flex-col items-start gap-4 rounded-md bg-surface-dark p-6 sm:flex-row sm:items-center sm:gap-6 sm:px-10 sm:py-8"
>
  <Icon name={icon} size={44} class="text-white" />
  <div class="flex-1">
    <h3 class="type-h3 text-on-dark">{title}</h3>
    <p class="mt-2 text-on-dark-muted"><slot /></p>
  </div>
  <Button variant="outline-light" href={href}>{action}</Button>
</div>
