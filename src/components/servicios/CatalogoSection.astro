---
import Reveal from 'astro-reveal/Reveal.astro';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import ServiceCard from '../cards/ServiceCard.astro';
import { SERVICES } from '../../data/home';
---

<Section id="servicios" tone="alt">
  <Reveal>
    <SectionHeading
      as="h1"
      align="center"
      title="Soluciones para entornos industriales"
      intro="Contamos con personal propio, equipos y procedimientos adecuados para brindar soluciones eficientes y seguras en todo tipo de entornos industriales. Nos adaptamos a los requerimientos específicos de cada cliente."
    />
  </Reveal>

  {/* All 10 services as equal featured cards, 2 per row */}
  <div class="mt-12 grid gap-x-6 gap-y-10 sm:grid-cols-2">
    {
      SERVICES.map((service, i) => (
        <Reveal index={i % 2}>
          <ServiceCard {...service} size="lg" href="/contacto" />
        </Reveal>
      ))
    }
  </div>
</Section>
