---
import { getIcon, type IconName } from '../../lib/icons';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className } = Astro.props;
const Svg = getIcon(name);
---

<Svg width={size} height={size} class:list={['shrink-0', className]} aria-hidden="true" />
