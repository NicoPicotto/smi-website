---
import { Image } from 'astro:assets';
import fullLogo from '../../assets/logo/smi-logo.png';
import isoLogo from '../../assets/logo/iso-logo.png';

interface Props {
  height?: number;
  /** `full`: isologo + wordmark. `iso`: hex mark only (header). */
  variant?: 'full' | 'iso';
  /** Flat white knockout for navy surfaces. */
  onDark?: boolean;
  loading?: 'eager' | 'lazy';
  class?: string;
}

const { height = 56, variant = 'full', onDark = false, loading = 'lazy', class: className } = Astro.props;
---

<Image
  src={variant === 'iso' ? isoLogo : fullLogo}
  alt="SMI Servicios Industriales"
  height={height}
  densities={[1, 2]}
  loading={loading}
  class:list={['block w-auto', onDark && 'brightness-0 invert', className]}
/>
