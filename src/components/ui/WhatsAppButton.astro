---
import Icon from './Icon.astro';
import { WHATSAPP_HREF } from '../../data/site';
---

<a
  href={WHATSAPP_HREF}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Escribinos por WhatsApp"
  class="fixed right-5 bottom-5 z-50 grid size-14 place-items-center rounded-full bg-whatsapp text-white shadow-media transition-colors duration-200 hover:bg-whatsapp-dark md:right-6 md:bottom-6 motion-safe:transition-[background-color,transform] motion-safe:hover:scale-105"
>
  <Icon name="whatsapp" size={30} />
</a>
