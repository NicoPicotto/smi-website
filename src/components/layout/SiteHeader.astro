---
import Logo from '../ui/Logo.astro';
import MobileNav from './MobileNav.astro';
import { NAV } from '../../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');

// Last nav item is rendered as the blue CTA
const items = NAV.slice(0, -1);
const cta = NAV[NAV.length - 1]!;
---

<header class="sticky top-0 z-70 hidden bg-surface shadow-header md:block">
  <div class="container-site flex h-(--header-h) items-center justify-between gap-8">
    <a href="/" class="shrink-0">
      <Logo variant="iso" loading="eager" height={82} class="drop-shadow-logo" />
    </a>

    <nav aria-label="Principal" class="flex items-center gap-6">
      {
        items.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'type-label py-4.5 text-xs',
              'hover:text-accent hover:shadow-[inset_0_-3px_0_var(--color-accent)]',
              isActive(item.href)
                ? 'text-accent shadow-[inset_0_-3px_0_var(--color-accent)]'
                : 'text-heading',
            ]}
          >
            {item.label}
          </a>
        ))
      }

      <a
        href={cta.href}
        aria-current={isActive(cta.href) ? 'page' : undefined}
        class="type-label rounded-sm bg-accent px-5 py-2.5 text-xs text-white hover:bg-navy-700 hover:text-white"
      >
        {cta.label}
      </a>
    </nav>
  </div>
</header>

<MobileNav />
